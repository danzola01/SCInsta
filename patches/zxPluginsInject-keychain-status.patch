--- a/src/SecRebinds.xm
+++ b/src/SecRebinds.xm
@@ -10,0 +11,28 @@
+
+// Diagnostic counters contain only operation names, OSStatus values and counts.
+static NSMutableDictionary *SCIKeychainStatusCounts(void) {
+    static NSMutableDictionary *counts;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{ counts = [NSMutableDictionary dictionary]; });
+    return counts;
+}
+
+static void SCIRecordKeychainStatus(NSString *operation, OSStatus status) {
+    NSMutableDictionary *counts = SCIKeychainStatusCounts();
+    @synchronized (counts) {
+        NSMutableDictionary *statuses = counts[operation];
+        if (!statuses) { statuses = [NSMutableDictionary dictionary]; counts[operation] = statuses; }
+        NSString *code = [NSString stringWithFormat:@"%d", (int)status];
+        statuses[code] = @([statuses[code] unsignedIntegerValue] + 1);
+    }
+}
+
+extern "C" __attribute__((visibility("default"))) NSDictionary *SCISideloadKeychainStatuses(void) {
+    NSMutableDictionary *counts = SCIKeychainStatusCounts();
+    @synchronized (counts) {
+        NSMutableDictionary *snapshot = [NSMutableDictionary dictionary];
+        for (NSString *operation in counts) snapshot[operation] = [counts[operation] copy];
+        return [snapshot copy];
+    }
+}
+
